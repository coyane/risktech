# Copia este archivo como .env para cambiar los valores en local.
# Las tres se leen al compilar: cambiar una exige volver a correr `npm run build`.

# URL pública de la landing. No hay dominio confirmado: el valor por defecto es un marcador.
PUBLIC_SITE_URL=https://innovacred.example

# false (por defecto): todas las páginas en noindex y robots.txt con Disallow: /.
# true: permite indexar la landing. El ingreso sigue en noindex.
# No se pasa a true mientras queden afirmaciones "por confirmar" en la página.
PUBLIC_INDEXABLE=false

# Adónde lleva el botón del ingreso (la app del diagnóstico).
PUBLIC_APP_URL=http://localhost:5173/
